+		if (ret)
+			return ret;
+
+		/* OCCM uses the v0 encoding: 0 default, 1 performance, 2 cool */
+		return data & HP_OMEN_EC_OCCM_MASK;
+	}
 
+	ret = ec_read(HP_OMEN_EC_THERMAL_PROFILE_OFFSET, &data);
 	if (ret)
 		return ret;
 
@@ -2371,6 +2483,8 @@
 		dev_warn(&device->dev,
 			 "Failed to set up platform profile support (%d)\n", err);
 
+	omen_host_alive_start();
+
 	return 0;
 }
 
