@@ -2436,6 +2552,9 @@
 				  hp_wmi_get_sw_state(HPWMI_WWAN),
 				  hp_wmi_get_hw_state(HPWMI_WWAN));
 
+	/* The EC may have dropped OCCN while we slept; re-arm it at once. */
+	omen_host_alive_kick();
+
